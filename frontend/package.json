{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix .",
    "ci:format": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "checks": "npm run ci:format && npx validate-branch-name && npm run typecheck && npm test",
    "prepare": "cd .. && husky frontend/.husky"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx}": [
      "eslint --fix --config ./frontend/eslint.config.mjs",
      "prettier --write --config ./frontend/.prettierrc"
    ],
    "frontend/**/*.{json,css,md,mjs,cjs}": [
      "prettier --write --config ./frontend/.prettierrc"
    ]
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.18.0",
    "@gravity-ui/navigation": "^6.1.0",
    "@gravity-ui/uikit": "^7.42.0",
    "@hookform/resolvers": "^5.4.0",
    "i18next": "^26.3.1",
    "next": "16.2.9",
    "next-i18next": "^16.0.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.80.0",
    "react-i18next": "^17.0.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "prettier": "3.8.4",
    "typescript": "^5",
    "validate-branch-name": "^1.3.2",
    "vitest": "^4.1.9"
  }
}
